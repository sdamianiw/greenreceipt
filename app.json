{
  "expo": {
    "name": "greenreceipt",
    "slug": "greenreceipt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E131C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sdamianiw.greenreceipt",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sdamianiw.greenreceipt",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E131C"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "GreenReceipt benötigt Kamerazugriff, um Verpackungsaussagen zu scannen."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f0aedcd6-2eb7-4fbd-a646-dfcc17b74be5"
      }
    }
  }
}
